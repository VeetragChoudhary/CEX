# Copy to .env for docker compose. Compose reads this file automatically.

# Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Database credentials (defaults shown; override if you like)
POSTGRES_USER=cex
POSTGRES_PASSWORD=cexpass
POSTGRES_DB=cex

# Host ports. Change these if something already occupies them.
FRONTEND_PORT=5173
BACKEND_PORT=3000
WS_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
